NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fantasy_football
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your-football-data-org-key
FOOTBALL_DATA_COMPETITION=PL
# Player pool + fantasy stats source: fpl (default — the official Fantasy
# Premier League API, free, no key needed), api-football, or football-data
# (no player stats on its free tier, so points stay 0).
PLAYER_STATS_PROVIDER=fpl
# Only needed for PLAYER_STATS_PROVIDER=api-football. Free key at
# https://www.api-football.com (free plan: 100 requests/day, seasons 2021-2023
# only — also set DEFAULT_SEASON=2023 and SEASON_START_DATE=2023-08-11).
# API_FOOTBALL_KEY=your-api-football-key
# API_FOOTBALL_DAILY_LIMIT=90
CORS_ORIGIN=http://localhost:5173
# Production example: CORS_ORIGIN=https://your-frontend.vercel.app
DEFAULT_LEAGUE_ID=39
DEFAULT_SEASON=2024
# First kickoff of the current FPL season (gameweek 1)
SEASON_START_DATE=2026-08-21
